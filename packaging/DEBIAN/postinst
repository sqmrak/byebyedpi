#!/bin/sh
# the daemon starts here, the tunnel stays off until byebyectl or the config asks

PAYLOAD_ROOT=/var/jb
if [ -e /var/jb/.procursus_strapped ] || \
   [ -x /var/jb/basebin/launchctl ] || \
   [ -x /var/jb/usr/bin/dpkg ]; then
  JBROOT=/var/jb
else
  JBROOT=
fi
LABEL=com.byebyedpi.byedpid
PLIST=${JBROOT}/Library/LaunchDaemons/${LABEL}.plist
LOG=/var/log/byebyedpi-system.log
LAUNCHCTL=${JBROOT}/bin/launchctl
[ -x "$LAUNCHCTL" ] || LAUNCHCTL=${JBROOT}/usr/bin/launchctl
[ -x "$LAUNCHCTL" ] || LAUNCHCTL=/bin/launchctl
[ -x "$LAUNCHCTL" ] || LAUNCHCTL=/usr/bin/launchctl

install_rootful_link() {
  source_path=$1
  target_path=$2
  [ -e "$source_path" ] || return 1
  mkdir -p "${target_path%/*}" || return 1
  if [ -L "$target_path" ]; then
    rm -f "$target_path" || return 1
  elif [ -e "$target_path" ]; then
    rm -rf "$target_path" || return 1
  fi
  ln -s "$source_path" "$target_path"
}

# the armv7 slice looks in /usr, so a rootful install gets links to the
# payload under /var/jb and a plist that names the linked binary
install_rootful_layout() {
  [ -z "$JBROOT" ] || return 0
  [ -x "${PAYLOAD_ROOT}/usr/bin/byedpid" ] || return 1
  [ -s "${PAYLOAD_ROOT}/usr/lib/byebyedpi/cacert.pem" ] || return 1
  # a fat binary started by launchd has no bootstrap port on ios 9, see build_deb.sh
  if [ "$(sysctl -n hw.cpu64bit_capable 2>/dev/null)" = 1 ]; then DAEMON_SLICE=arm64; else DAEMON_SLICE=armv7; fi
  [ -x "${PAYLOAD_ROOT}/usr/lib/byebyedpi/${DAEMON_SLICE}/byedpid" ] || return 1
  install_rootful_link "${PAYLOAD_ROOT}/usr/lib/byebyedpi/${DAEMON_SLICE}/byedpid" /usr/bin/byedpid || return 1
  install_rootful_link "${PAYLOAD_ROOT}/usr/bin/byebyectl" /usr/bin/byebyectl || return 1
  install_rootful_link "${PAYLOAD_ROOT}/usr/lib/byebyedpi" /usr/lib/byebyedpi || return 1
  source_path="${PAYLOAD_ROOT}/Library/LaunchDaemons/${LABEL}.plist"
  target_path=/Library/LaunchDaemons/${LABEL}.plist
  mkdir -p "${target_path%/*}" || return 1
  temp_path="${target_path}.dpkg-new"
  sed 's#<string>/var/jb/usr/bin/byedpid</string>#<string>/usr/bin/byedpid</string>#' \
    "$source_path" > "$temp_path" || return 1
  rm -f "$target_path"
  mv "$temp_path" "$target_path" || return 1
  chown root:wheel "$target_path" 2>/dev/null || true
  chmod 644 "$target_path" 2>/dev/null || true
  [ -s "$target_path" ]
}

# the vpn badge hook is a substrate tweak for springboard, ios 5 to 11 only
firmware_major() {
  version="$(sed -n '/<key>ProductVersion<\/key>/{n;s/.*<string>\([0-9][0-9]*\)\..*<\/string>.*/\1/p;q;}' \
    /System/Library/CoreServices/SystemVersion.plist 2>/dev/null)"
  if [ -z "$version" ]; then
    # a binary SystemVersion.plist reads empty, the kernel version still maps
    # to the ios major: darwin 15 and later run six ahead, below that a table
    darwin="$(uname -r 2>/dev/null | sed -n 's/^\([0-9][0-9]*\)\..*/\1/p')"
    case "$darwin" in
      11|12) version=5 ;;
      13) version=6 ;;
      14) version=7 ;;
      *) [ "$darwin" -ge 15 ] 2>/dev/null && version=$((darwin - 6)) ;;
    esac
  fi
  printf '%s\n' "$version"
}

if [ -d /Library/MobileSubstrate/DynamicLibraries ]; then
  HOOK_DIR=/Library/MobileSubstrate/DynamicLibraries
elif [ -d /usr/lib/TweakInject ]; then
  HOOK_DIR=/usr/lib/TweakInject
else
  HOOK_DIR=
fi

remove_status_hook() {
  for dir in /Library/MobileSubstrate/DynamicLibraries /usr/lib/TweakInject; do
    rm -f "${dir}/byebyedpi-status.dylib" "${dir}/byebyedpi-status.plist"
  done
}

install_status_hook() {
  [ -f "${PAYLOAD_ROOT}/usr/lib/byebyedpi/status.dylib" ] || return 1
  ln -sf "${PAYLOAD_ROOT}/usr/lib/byebyedpi/status.dylib" "${HOOK_DIR}/byebyedpi-status.dylib" || return 1
  cp "${PAYLOAD_ROOT}/usr/lib/byebyedpi/status.plist" "${HOOK_DIR}/byebyedpi-status.plist" || return 1
  chown root:wheel "${HOOK_DIR}/byebyedpi-status.plist" 2>/dev/null || true
  chmod 644 "${HOOK_DIR}/byebyedpi-status.plist" 2>/dev/null || true
}

# ios 5 to 11 need the substrate shim to negotiate tls 1.3
remove_byebyetlsfix() {
  for dir in /Library/MobileSubstrate/DynamicLibraries /usr/lib/TweakInject; do
    rm -f "${dir}/byebyetlsfix.dylib" "${dir}/byebyetlsfix.plist"
  done
}

install_byebyetlsfix() {
  # safari runs as mobile and cannot create its log in /var/log
  BYETLSFIX_LOG=/var/log/byebyetlsfix.log
  [ ! -L "$BYETLSFIX_LOG" ] || return 1
  [ ! -e "$BYETLSFIX_LOG" ] || [ -f "$BYETLSFIX_LOG" ] || return 1
  : >> "$BYETLSFIX_LOG" || return 1
  chown root:mobile "$BYETLSFIX_LOG" || return 1
  chmod 660 "$BYETLSFIX_LOG" || return 1
  [ -f "${PAYLOAD_ROOT}/usr/lib/byebyedpi/byebyetlsfix.dylib" ] || return 1
  ln -sf "${PAYLOAD_ROOT}/usr/lib/byebyedpi/byebyetlsfix.dylib" "${HOOK_DIR}/byebyetlsfix.dylib" || return 1
  cp "${PAYLOAD_ROOT}/usr/lib/byebyedpi/byebyetlsfix.plist" "${HOOK_DIR}/byebyetlsfix.plist" || return 1
  chown root:wheel "${HOOK_DIR}/byebyetlsfix.plist" 2>/dev/null || true
  chmod 644 "${HOOK_DIR}/byebyetlsfix.plist" 2>/dev/null || true
  # the apps the shim serves are the user's to edit, so an upgrade keeps the file
  BYETLSFIX_PREFS=/var/mobile/Library/Preferences/com.byebyedpi.byebyetlsfix.plist
  if [ ! -s "$BYETLSFIX_PREFS" ]; then
    cp "${PAYLOAD_ROOT}/usr/lib/byebyedpi/byebyetlsfix/prefs.plist" "$BYETLSFIX_PREFS" || return 1
    chown mobile:mobile "$BYETLSFIX_PREFS" 2>/dev/null || true
    chmod 644 "$BYETLSFIX_PREFS" 2>/dev/null || true
  fi
}

# ios 6 launchctl keeps the inherited bootstrap when either variable is set
launchctl_cmd() {
  (unset LAUNCHD_SOCKET LaunchKeepContext; "$LAUNCHCTL" "$@")
}

# h3lix on ios 10 reports success without loading, so check the job list
launchd_loaded() {
  jobs="$(launchctl_cmd list 2>/dev/null)" || return 2
  [ -n "$jobs" ] || return 2
  printf '%s\n' "$jobs" | (
    while read -r pid status job extra; do
      [ "$job" = "$LABEL" ] && [ -z "$extra" ] && exit 0
    done
    exit 1
  )
}

# preserve its first error when the job fails to load
launchd_attempt() {
  out="$(launchctl_cmd "$@" 2>&1)"
  status=$?
  launchd_loaded && return 0
  LAUNCHD_LAST_ERROR="$(printf '%s' "$out" | sed -n '1p')"
  echo "postinst: diag launchctl $1: exit $status, $LAUNCHD_LAST_ERROR" >> "$LOG" 2>/dev/null
  return 1
}

# the session type a plist is judged against comes from the bootstrap launchctl runs in
diagnose_launchd_load() {
  echo "postinst: diag session: uid $(id -ur 2>/dev/null), euid $(id -u 2>/dev/null), manager $("$LAUNCHCTL" managername 2>&1 | sed -n '1p')" >> "$LOG" 2>/dev/null
  echo "postinst: diag plist: $(ls -ln "$PLIST" 2>&1)" >> "$LOG" 2>/dev/null
  echo "postinst: diag env: LAUNCHD_SOCKET=${LAUNCHD_SOCKET:-unset} LaunchKeepContext=${LaunchKeepContext:-unset}" >> "$LOG" 2>/dev/null
}

byedpid_answers() {
  # launchctl can list a job whose process exits before it opens the socket
  attempt=0
  while [ "$attempt" -lt 8 ]; do
    reply="$("${PAYLOAD_ROOT}/usr/bin/byebyectl" status 2>/dev/null)"
    case "$reply" in
      OK*)
        echo "postinst: byedpid answered status" >> "$LOG" 2>/dev/null
        return 0 ;;
    esac
    attempt=$((attempt + 1))
    [ "$attempt" -lt 8 ] && sleep 1
  done
  echo "postinst: byedpid did not answer status after start" >> "$LOG" 2>/dev/null
  return 1
}

# ios 6 can list jobs over mach while launch_msg has no unix socket
start_without_launchd_socket() {
  [ -z "$JBROOT" ] || return 1
  case "$(firmware_major)" in 5|6) ;; *) return 1 ;; esac
  [ "$LAUNCHD_LAST_ERROR" = 'launch_msg(): Socket is not connected' ] || return 1
  launchd_loaded
  [ $? = 1 ] || return 1
  [ "$(launchctl_cmd managername 2>/dev/null)" = System ] || return 1
  reply="$("${PAYLOAD_ROOT}/usr/bin/byebyectl" status 2>/dev/null)"
  case "$reply" in OK*) return 0 ;; esac
  echo "postinst: launchd socket unavailable, starting byedpid directly until reboot" >> "$LOG" 2>/dev/null
  /usr/bin/byedpid </dev/null >> "$LOG" 2>&1 &
  byedpid_answers
}

launchd_start() {
  if [ ! -x "$LAUNCHCTL" ]; then
    echo "byebyedpi: no launchctl found, the daemon was not started" >&2
    return 1
  fi
  if ! { launchd_attempt bootstrap system "$PLIST" || \
         launchd_attempt load -w "$PLIST" || \
         launchd_attempt load "$PLIST"; }; then
    start_without_launchd_socket && return 0
    diagnose_launchd_load
    echo "byebyedpi: launchd did not load ${PLIST} (${LAUNCHD_LAST_ERROR:-no launchctl output})" >&2
    echo "postinst: launchd did not load ${PLIST}" >> "$LOG" 2>/dev/null
    return 1
  fi
  echo "postinst: launchd holds ${LABEL}" >> "$LOG" 2>/dev/null
  launchctl_cmd enable "system/${LABEL}" >/dev/null 2>&1 || true
  launchctl_cmd kickstart -k "system/${LABEL}" >/dev/null 2>&1 || \
    launchctl_cmd start "$LABEL" >/dev/null 2>&1 || true
  byedpid_answers
}

install_rootful_layout || {
  echo "byebyedpi: cannot place the daemon, its tls roots or its launchd plist on rootful iOS" >&2
  exit 1
}

chown root:wheel "$PLIST" 2>/dev/null || true
chmod 644 "$PLIST" 2>/dev/null || true
for bin in "${PAYLOAD_ROOT}/usr/bin/byedpid" "${PAYLOAD_ROOT}/usr/bin/byebyectl"; do
  [ -e "$bin" ] && chown root:wheel "$bin" 2>/dev/null && chmod 755 "$bin" || true
done

# ios 12 and later show no badge for a daemon tunnel, and a hook there only
# adds a way to crash springboard
remove_status_hook
if [ -z "$JBROOT" ] && [ -n "$HOOK_DIR" ] && [ "$(firmware_major)" -lt 12 ] 2>/dev/null; then
  if install_status_hook; then
    HOOK_INSTALLED=1
  else
    echo "byebyedpi: cannot install the vpn badge hook into ${HOOK_DIR}" >&2
  fi
fi

remove_byebyetlsfix
if [ -z "$JBROOT" ] && [ -n "$HOOK_DIR" ] && [ "$(firmware_major)" -lt 12 ] 2>/dev/null; then
  install_byebyetlsfix || echo "byebyedpi: cannot install byebyetlsfix into ${HOOK_DIR}" >&2
  if [ -e "${HOOK_DIR}/tlsfix.dylib" ] || [ -e "${HOOK_DIR}/senkotlsfix.dylib" ]; then
    echo "postinst: external tlsfix or senkotlsfix installed, byebyetlsfix stays disabled" >> "$LOG" 2>/dev/null
  fi
fi

mkdir -p /var/mobile/Library/Preferences/byebyedpi-hosts 2>/dev/null || true
chown mobile:mobile /var/mobile/Library/Preferences/byebyedpi-hosts 2>/dev/null || true
chmod 755 /var/mobile/Library/Preferences/byebyedpi-hosts 2>/dev/null || true

# a second copy of the daemon would hold a second utun and its routes
if [ -x "${PAYLOAD_ROOT}/usr/bin/byebyectl" ]; then
  "${PAYLOAD_ROOT}/usr/bin/byebyectl" stop >/dev/null 2>&1 || true
fi

# rootful springboard lists /Applications, rootless uicache registers /var/jb/Applications
APP_PAYLOAD=${PAYLOAD_ROOT}/Applications/ByeByeDPI.app
UICACHE=${JBROOT}/usr/bin/uicache
[ -x "$UICACHE" ] || UICACHE=/usr/bin/uicache
KILLALL=${JBROOT}/usr/bin/killall
[ -x "$KILLALL" ] || KILLALL=/usr/bin/killall
[ -x "$KILLALL" ] || KILLALL=/bin/killall
INSTALL_CACHE=/var/mobile/Library/Caches/com.apple.mobile.installation.plist
SU=/bin/su
[ -x "$SU" ] || SU=/usr/bin/su

install_app() {
  [ -d "$APP_PAYLOAD" ] || return 1
  if [ -z "$JBROOT" ]; then
    APP=/Applications/ByeByeDPI.app
    rm -rf "${APP}.dpkg-new" 2>/dev/null || true
    cp -R "$APP_PAYLOAD" "${APP}.dpkg-new" || return 1
    : > "${APP}.dpkg-new/.byebyedpi-rootful-copy"
    [ -L "$APP" ] && rm -f "$APP"
    rm -rf "$APP" 2>/dev/null || true
    mv "${APP}.dpkg-new" "$APP" || return 1
    chown -R root:wheel "$APP" 2>/dev/null || true
    chmod 755 "$APP" "$APP/ByeByeDPI" 2>/dev/null || true
    # the cached icon bitmap is keyed by the plist's file list, which a new icon does not change
    rm -f /var/mobile/Library/Caches/com.apple.IconsCache/com.byebyedpi.app_* 2>/dev/null || true
  else
    APP=$APP_PAYLOAD
  fi
  # the old binary keeps running from memory after an upgrade
  "$KILLALL" -9 ByeByeDPI >/dev/null 2>&1 || true
  [ -x "$UICACHE" ] || return 0
  # ios 7 and older keep the app list in mobile's installation cache, and uicache run as root stops
  # at "cannot open cache file. incorrect user?"; newer uicache needs root
  refresh_app_cache() {
    if [ -z "$JBROOT" ] && [ -f "$INSTALL_CACHE" ] && [ -x "$SU" ]; then
      "$SU" - mobile -c "$UICACHE -p $APP" && return 0
      "$SU" - mobile -c "$UICACHE" && return 0
    fi
    "$UICACHE" -p "$APP" || "$UICACHE"
  }
  # backgrounding avoids an ios 6 uicache deadlock while the old app is still alive
  ( refresh_app_cache >/dev/null 2>&1 || true ) </dev/null &
  return 0
}

install_app || echo "byebyedpi: the app could not be put in place" >&2

# ios 5 and 6 need a respring to draw the new icon and load the badge hook
# let dpkg record the configured state before springboard exits
if [ -z "$JBROOT" ] && [ -f "$INSTALL_CACHE" ] && [ "${BYE_SKIP_RESPRING:-0}" != "1" ]; then
  ( sleep 3; "$KILLALL" -9 SpringBoard >/dev/null 2>&1 || true ) </dev/null >/dev/null 2>&1 &
elif [ "${HOOK_INSTALLED:-0}" = 1 ]; then
  echo "byebyedpi: respring once to show the vpn badge" >&2
fi

# a daemon that does not answer is reported and logged above, but the files are in place:
# exiting 1 here leaves the package half-configured and cydia then blocks every other install
launchd_start || echo "byebyedpi: the daemon is not running, see ${LOG}" >&2
exit 0
